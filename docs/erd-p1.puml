@startuml
!theme plain
skinparam linetype ortho
skinparam roundcorner 4

entity "Customers" as customers {
    * CustomerId : INT <<PK, identity>>
    --
    * ExternalId : UNIQUEIDENTIFIER <<UQ>>
    * FullName : NVARCHAR(100)
    * Email : NVARCHAR(255) <<UQ>>
    * Phone : NVARCHAR(30)
    * CreatedAt : DATETIME2
    * CreatedBy : NVARCHAR(100)
    UpdatedAt : DATETIME2
    UpdatedBy : NVARCHAR(100)
    * IsDeleted : BIT
}

entity "Orders" as orders {
    * OrderId : INT <<PK, identity>>
    --
    * OrderNumber : NVARCHAR(32) <<UQ>>
    * CustomerId : INT <<FK>>
    * Status : NVARCHAR(32)
    * TotalAmount : DECIMAL(18,2)
    * RowVersion : ROWVERSION
    * CreatedAt : DATETIME2
    * CreatedBy : NVARCHAR(100)
    UpdatedAt : DATETIME2
    UpdatedBy : NVARCHAR(100)
    * IsDeleted : BIT
}

entity "OrderDetails" as order_details {
    * OrderId : INT <<PK, FK>>
    --
    * RecipientName : NVARCHAR(100)
    * RecipientPhone : NVARCHAR(30)
    * ShippingAddress : NVARCHAR(255)
    * City : NVARCHAR(100)
    PostalCode : NVARCHAR(20)
    * ShippingMethod : NVARCHAR(50)
    TrackingNumber : NVARCHAR(100)
    DeliveredAt : DATETIME2
    * CreatedAt : DATETIME2
    * CreatedBy : NVARCHAR(100)
    UpdatedAt : DATETIME2
    UpdatedBy : NVARCHAR(100)
    * IsDeleted : BIT
}

entity "Products" as products {
    * ProductId : INT <<PK>>
    --
    * Sku : NVARCHAR(64) <<UQ>>
    * Name : NVARCHAR(200)
    * Price : DECIMAL(18,2)
    * IsAvailable : BIT
    * CreatedAt : DATETIME2
    * CreatedBy : NVARCHAR(100)
    UpdatedAt : DATETIME2
    UpdatedBy : NVARCHAR(100)
    * IsDeleted : BIT
}

entity "OrderItems" as order_items {
    * OrderId : INT <<PK, FK>>
    * ProductId : INT <<PK, FK>>
    --
    * ProductName : NVARCHAR(200)
    * UnitPrice : DECIMAL(18,2)
    * Units : INT
    * SubTotal : DECIMAL(18,2) <<computed>>
    * CreatedAt : DATETIME2
    * CreatedBy : NVARCHAR(100)
    UpdatedAt : DATETIME2
    UpdatedBy : NVARCHAR(100)
    * IsDeleted : BIT
}

entity "OrderStatusHistory" as order_status_history {
    * HistoryId : INT <<PK, identity>>
    --
    * OrderId : INT <<FK>>
    FromStatus : NVARCHAR(32)
    * ToStatus : NVARCHAR(32)
    Reason : NVARCHAR(255)
    * CreatedAt : DATETIME2
    * CreatedBy : NVARCHAR(100)
}

customers ||--o{ orders : "places"
orders ||--|| order_details : "has delivery"
orders ||--|{ order_items : "contains"
products ||--o{ order_items : "referenced by"
orders ||--o{ order_status_history : "tracks"

@enduml
