{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "aggregator-route": {
        "ClusterId": "aggregator",
        "Match": {
          "Path": "/api/aggregator/{**catch-all}"
        }
      },
      "aggregate-route": {
        "ClusterId": "aggregator",
        "Match": {
          "Path": "/api/aggregate/{**catch-all}"
        }
      },
      "orders-route": {
        "ClusterId": "orders",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      },
      "catalog-products-route": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/products/{**catch-all}"
        }
      },
      "catalog-brands-route": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/brands/{**catch-all}"
        }
      },
      "catalog-categories-route": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/categories/{**catch-all}"
        }
      },
      "reviews-route": {
        "ClusterId": "reviews",
        "Match": {
          "Path": "/api/reviews/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "orders": {
        "Destinations": {
          "destination1": {
            "Address": "http://orders-api"
          }
        }
      },
      "catalog": {
        "Destinations": {
          "destination1": {
            "Address": "http://catalog-api"
          }
        }
      },
      "reviews": {
        "Destinations": {
          "destination1": {
            "Address": "http://reviews-api"
          }
        }
      },
      "aggregator": {
        "Destinations": {
          "destination1": {
            "Address": "http://aggregator"
          }
        }
      }
    }
  }
}
